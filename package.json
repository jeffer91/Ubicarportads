{
  "name": "ubicarportads",
  "version": "1.1.0",
  "private": true,
  "description": "Aplicación de escritorio para preparar portadas PDF antes de la firma electrónica.",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node scripts/install.js",
    "start": "electron .",
    "dev": "electron . --devtools",
    "test": "node --test tests/*.test.js",
    "build:backend": "node scripts/build-backend.js",
    "dist:win": "npm run build:backend && electron-builder --win nsis --x64"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ec.jeffer.ubicarportads",
    "productName": "Ubicarportads",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "electron/**/*",
      "web/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend-dist/ubicarportads-api",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
